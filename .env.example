# Copy to .env. Never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SIGNING_SECRET=replace-with-at-least-48-random-characters-generated-by-a-password-manager
CONNECTOR_CREDENTIAL_KEY=replace-with-at-least-48-random-characters-for-connector-encryption
CONNECTOR_CREDENTIAL_KEY_VERSION=1
# During rotation, retain the old key here until all connector credentials have been refreshed.
CONNECTOR_PREVIOUS_CREDENTIAL_KEY=
CONNECTOR_PREVIOUS_CREDENTIAL_KEY_VERSION=0
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-github-webhook-secret

# Gemini is the provider. OpenAI-compatible describes only the HTTP protocol.
GEMINI_API_KEY=replace-with-live-provider-key
AI_PROVIDER=gemini
AI_PROTOCOL=openai-compatible
EMBEDDING_PROVIDER=gemini
EMBEDDING_PROTOCOL=openai-compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
# Optional override when embeddings use a separate Gemini project/key.
EMBEDDING_API_KEY=

# Optional reranker. Leave empty to use reciprocal-rank fusion only.
COHERE_API_KEY=

# Browser origin allowed by the API. Use the public HTTPS origin in production.
ALLOWED_ORIGINS=http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8081

# Enable only when an OTLP collector is reachable.
TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Optional live GitHub App. The seeded demo works without these values.
GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
# Base64 of an RSA PKCS#8 private key. Do not commit the decoded or encoded key.
GITHUB_APP_PRIVATE_KEY_PKCS8_BASE64=

# Optional Atlassian OAuth 2.0 (3LO). Manual/demo evidence works without it.
ATLASSIAN_INTEGRATION_ENABLED=false
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8080/api/integrations/atlassian/oauth/callback
